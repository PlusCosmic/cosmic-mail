{
  "name": "tauri-app",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node --test e2e/*.test.mjs",
    "e2e:env:up": "docker compose -f e2e/docker-compose.yml up -d && node e2e/seed.mjs",
    "e2e:env:down": "docker compose -f e2e/docker-compose.yml down -v",
    "promote:local": "bash scripts/promote-local.sh",
    "tauri": "tauri"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.11"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
