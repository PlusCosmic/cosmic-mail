# OS and editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# JavaScript / Svelte build output
node_modules/
/coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arch packages left behind by packaging/build-local.sh
/*.pkg.tar.zst

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# Exception: the committed, throwaway E2E TLS fixture (test-only localhost
# cert/keystore, trusted only by a debug build via COSMIC_MAIL_EXTRA_CA).
!e2e/fixtures/tls/ca.pem
!e2e/fixtures/tls/localhost.p12

# Tool-generated temporary files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Claude Code local (per-machine) settings
.claude/settings.local.json

# Go / Wails build output
/bin/
/.task/
/build/linux/appimage/build/
# Regenerated by `wails3 task build` (generate:dotdesktop)
/build/linux/cosmic-mail.desktop

# Frontend (moved under frontend/ for Wails)
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/.svelte-kit/
frontend/package/
frontend/vite.config.js.timestamp-*
frontend/vite.config.ts.timestamp-*
