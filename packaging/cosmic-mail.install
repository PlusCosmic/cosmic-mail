# pacman cannot enable or restart a unit inside a user's session, so both the
# first-run enable and the post-upgrade restart are left to the user.

post_install() {
  cat <<'EOF'
Cosmic Mail installs a systemd user unit for background IMAP IDLE, notifications
and the tray icon. Enable it once per user:

    systemctl --user enable --now cosmic-mail.service

If this machine also has a local daily build (npm run promote:local), that
install shadows this one: ~/.local/share/applications/dev.pluscosmic.mail.desktop
and ~/.config/systemd/user/cosmic-mail.service take precedence over the packaged
copies, and both builds share one application identifier, account config,
keyring entries and SQLite cache. Remove the local daily install before relying
on the package.
EOF
}

post_upgrade() {
  cat <<'EOF'
Restart the background service to pick up the new binary:

    systemctl --user restart cosmic-mail.service
EOF
}

pre_remove() {
  cat <<'EOF'
Stop and disable the background service if you have not already:

    systemctl --user disable --now cosmic-mail.service
EOF
}
