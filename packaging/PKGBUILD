# Maintainer: Harry Leach <harry@pluscosmic.dev>
#
# Built by .github/workflows/publish-arch-repo.yml, which supplies PKGVER and
# PKGREL and drops the source tarball alongside this file. To build by hand,
# use packaging/build-local.sh rather than calling makepkg directly.

pkgname=cosmic-mail
pkgver="${PKGVER:?PKGVER must be set (see packaging/build-local.sh)}"
pkgrel="${PKGREL:?PKGREL must be set (see packaging/build-local.sh)}"
pkgdesc="A native Linux mail client for omarchy, built with Tauri"
arch=('x86_64')
url="https://github.com/PlusCosmic/cosmic-mail"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'libsecret'
         'hicolor-icon-theme')
makedepends=('rust' 'nodejs' 'npm')
optdepends=('uwsm: session-scoped launching, used by the desktop entry'
            'gnome-keyring: Secret Service provider for account credentials'
            'mako: desktop notifications')
install=cosmic-mail.install
source=("$pkgname-$pkgver.tar.gz"
        'cosmic-mail.desktop'
        'cosmic-mail.service')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

build() {
  cd "$srcdir/src"

  npm ci

  # --no-bundle produces a standalone binary with the frontend embedded, the
  # same artifact scripts/promote-local.sh installs. The deb/AppImage bundlers
  # would download tooling at build time and produce formats pacman can't use.
  npm run tauri -- build --no-bundle
}

package() {
  cd "$srcdir/src"

  install -Dm755 src-tauri/target/release/cosmic-mail \
    "$pkgdir/usr/bin/cosmic-mail"

  for _size in 32x32 64x64 128x128; do
    install -Dm644 "src-tauri/icons/$_size.png" \
      "$pkgdir/usr/share/icons/hicolor/$_size/apps/cosmic-mail.png"
  done

  # The desktop ID matches the app's notification hint, so it must stay
  # dev.pluscosmic.mail rather than following $pkgname.
  install -Dm644 "$srcdir/cosmic-mail.desktop" \
    "$pkgdir/usr/share/applications/dev.pluscosmic.mail.desktop"

  install -Dm644 "$srcdir/cosmic-mail.service" \
    "$pkgdir/usr/lib/systemd/user/cosmic-mail.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
